{
  "name": "sergey-a-gorbachev/test-notes",
  "description": "Small REST API for notes built on Symfony 8.1",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.5",
    "nelmio/api-doc-bundle": "^5.9",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/property-access": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/serializer": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpunit/phpunit": "^12.5",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "cs:check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
    "quality": [
      "@cs:check",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
