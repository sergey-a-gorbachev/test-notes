<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true">
    <php>
        <env name="APP_ENV" value="test" force="true" />
        <env name="KERNEL_CLASS" value="App\Kernel" force="true" />
        <env name="APP_DEBUG" value="1" force="true" />
        <env name="APP_SECRET" value="test-secret" force="true" />
        <env name="DATABASE_URL" value="sqlite:///%kernel.project_dir%/var/data/notes_test.sqlite" force="true" />
    </php>
    <testsuites>
        <testsuite name="Notes API">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
